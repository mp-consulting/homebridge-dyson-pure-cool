{
  "name": "@mp-consulting/homebridge-dyson-pure-cool",
  "displayName": "Dyson Pure Cool",
  "type": "module",
  "version": "1.4.0",
  "private": false,
  "description": "Homebridge plugin for Dyson Pure Cool air purifiers and fans. Control fan speed, monitor air quality, temperature, and humidity via HomeKit.",
  "author": "MP Consulting",
  "license": "MIT",
  "homepage": "https://github.com/mp-consulting/homebridge-dyson-pure-cool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-dyson-pure-cool.git"
  },
  "bugs": {
    "url": "https://github.com/mp-consulting/homebridge-dyson-pure-cool/issues"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "dyson",
    "pure-cool",
    "air-purifier",
    "fan",
    "air-quality",
    "temperature",
    "humidity",
    "smart-home"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "copy:ui-assets": "mp-ui-kit-copy --vendor",
    "build": "npm run copy:ui-assets && rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "@mp-consulting/homebridge-ai-kit": "file:../homebridge-mcp-server",
    "bonjour-service": "^1.4.4",
    "class-validator": "^0.15.1",
    "homebridge-lib": "^8.1.5",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mp-consulting/homebridge-ui-kit": "file:../homebridge-ui-kit",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^10.10.0",
    "homebridge": "^2.4.0",
    "homebridge-config-ui-x": "^5.29.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@nestjs/platform-fastify": "^12.1.2",
    "fastify": "^5.12.5"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ]
}
